{
  "name": "krakvamcl-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "KrakvaMCL desktop launcher",
  "main": "electron-main.js",
  "scripts": {
    "start": "node launch-electron.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.krakvamcl.launcher",
    "productName": "KrakvaMCL Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
